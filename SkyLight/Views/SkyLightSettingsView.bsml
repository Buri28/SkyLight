<bg>
  <!-- タブで分ける（縦に長かったため）。各タブは中身をスクロールできる。 -->
  <tab-selector tab-tag='skylight-tabs' anchor-min-x='0' anchor-max-x='1' anchor-min-y='1' anchor-max-y='1' size-delta-x='-4' size-delta-y='6' anchor-pos-y='-3' />

  <tab tags='skylight-tabs' tab-name='Main' anchor-min-x='0' anchor-max-x='1' anchor-min-y='0' anchor-max-y='1' size-delta-y='-8' anchor-pos-y='-4'>
    <settings-container child-control-width='true' child-expand-width='true' spacing='0' pad='0'>
    <!-- MOD全体の有効/無効・共通設定 -->
    <toggle-setting text='Enabled'
                    value='enabled'
                    apply-on-change='true'
                    bind-value='true'
                    hover-hint='Enable or disable SkyLight.' />

    <toggle-setting text='Bloom'
                    value='bloom'
                    apply-on-change='true'
                    bind-value='true'
                    hover-hint='Full-screen Bloom ON/OFF. ON = notes/lasers glow. Works with Sky Background too.' />

    <!-- ───────── Show / Hide（表示/非表示のまとめ。2列で省スペース） ───────── -->
    <horizontal spacing='1' pad='0' pad-top='1'>
      <text text='[Show / Hide]' color='#90EE90' />
    </horizontal>

    <horizontal spacing='2' pad='0' pref-height='8' child-control-width='true' child-control-height='true' child-expand-width='true' child-expand-height='false'>
      <toggle-setting text='Sky Background' pref-width='52' value='recolor-background' apply-on-change='true' bind-value='true'
                      hover-hint='Hide the dark game background and wrap the view in a sky-colored dome. Same as Show Sky Background in the Sky / Floor tab.' />
      <toggle-setting text='Floor' pref-width='52' value='show-floor' apply-on-change='true' bind-value='true'
                      hover-hint='Show or hide the floor. Same as Show Floor in the Sky / Floor tab.' />
    </horizontal>

    <horizontal spacing='2' pad='0' pref-height='8' child-control-width='true' child-control-height='true' child-expand-width='true' child-expand-height='false'>
      <toggle-setting text='Structures' pref-width='52' value='show-structures' apply-on-change='true' bind-value='true'
                      hover-hint='Show or hide matched structure objects. Same as Show Structures in the Objects tab.' />
      <toggle-setting text='Ring' pref-width='52' value='show-ring' apply-on-change='true' bind-value='true'
                      hover-hint='Show or hide matched ring objects. Same as Show Ring in the Objects tab.' />
    </horizontal>

    <horizontal spacing='2' pad='0' pref-height='8' child-control-width='true' child-control-height='true' child-expand-width='true' child-expand-height='false'>
      <toggle-setting text='Neon' pref-width='52' value='show-neon' apply-on-change='true' bind-value='true'
                      hover-hint='Show the NeonLight layer (moving neon bars / lasers / cyan beams). Takes effect from the next song.' />
      <toggle-setting text='Bars' pref-width='52' value='show-bars' apply-on-change='true' bind-value='true'
                      hover-hint='Show or hide Spectrogram bars.' />
    </horizontal>

    <horizontal spacing='2' pad='0' pref-height='8' child-control-width='true' child-control-height='true' child-expand-width='true' child-expand-height='false'>
      <toggle-setting text='Side Lanes' pref-width='52' value='show-side-lanes' apply-on-change='true' bind-value='true'
                      hover-hint='Show or hide the side lanes and track-side black strips beside the floor.' />
      <toggle-setting text='Lights' pref-width='52' value='show-lights' apply-on-change='true' bind-value='true'
                      hover-hint='Show or hide light objects (name contains "Light"). Takes effect from the next song.' />
    </horizontal>

    <horizontal spacing='2' pad='0' pref-height='8' child-control-width='true' child-control-height='true' child-expand-width='true' child-expand-height='false'>
      <toggle-setting text='Logo' pref-width='52' value='show-logo' apply-on-change='true' bind-value='true'
                      hover-hint='Show or hide environment logo objects (name contains "Logo"). Takes effect from the next song.' />
      <toggle-setting text='Others' pref-width='52' value='show-other-structures' apply-on-change='true' bind-value='true'
                      hover-hint='Show or hide misc environment objects (Window/Tunnel/Waterfall/Sun/Rain/Clouds/Smoke/Building/Mountain/Star etc.). Takes effect from the next song.' />
    </horizontal>

    <horizontal spacing='2' pad='0' pref-height='8' child-control-width='true' child-control-height='true' child-expand-width='true' child-expand-height='false'>
      <toggle-setting text='Custom BG' pref-width='52' value='show-custom-background' apply-on-change='true' bind-value='true'
                      hover-hint='Show the CustomBackgrounds mod image during songs (independent of Neon). Takes effect from the next song.' />
      <toggle-setting text='HUD BG' pref-width='52' value='show-hud-background' apply-on-change='true' bind-value='true'
                      hover-hint='Show the dark panels behind the score/combo HUD (BasicGameHUD LeftPanel/RightPanel BG). Visible as tall dark strips on a bright sky. Takes effect from the next song.' />
    </horizontal>

    <!-- ───────── Presets ───────── -->
    <horizontal spacing='1' pad='0' pad-top='1'>
      <text text='[Presets]' color='#FF8FB3' />
    </horizontal>

    <dropdown-list-setting text='Preset'
                           id='preset-dropdown'
                           value='preset-selected'
                           options='preset-options'
                           apply-on-change='true'
                           bind-value='true'
                           on-change='select-preset'
                           hover-hint='Saved presets in UserData/SkyLight/. Pick one and press Load.' />

    <horizontal spacing='1' pad='0'>
      <button text='Load' on-click='load-preset'
              hover-hint='Apply the selected preset to all settings.' />
      <button text='Delete' on-click='delete-preset'
              hover-hint='Delete the selected preset file.' />
    </horizontal>

    <string-setting text='Save As'
                    value='preset-name'
            apply-on-change='true'
            bind-value='true'
            hover-hint='Name for a new preset. Leave blank to overwrite the selected one.' />

    <horizontal spacing='1' pad='0'>
      <button text='Save Preset' on-click='save-preset'
              hover-hint='Save the current settings as a preset with the name above.' />
    </horizontal>

    <!-- ───────── Reset ───────── -->
    <horizontal spacing='1' pad='0' pad-top='2'>
      <button text='Reset to Defaults' on-click='reset-settings' />
    </horizontal>
    </settings-container>
  </tab>
  <tab tags='skylight-tabs' tab-name='Sky / Floor' anchor-min-x='0' anchor-max-x='1' anchor-min-y='0' anchor-max-y='1' size-delta-y='-8' anchor-pos-y='-4'>
    <settings-container child-control-width='true' child-expand-width='true' spacing='0' pad='0'>
    <!-- ───────── Background (sky dome) ───────── -->
    <horizontal spacing='1' pad='0' pad-top='1'>
      <text text='[Background]' color='#FF8C00' />
    </horizontal>

    <toggle-setting text='Show Sky Background'
                    value='recolor-background'
                    apply-on-change='true'
                    bind-value='true'
                    hover-hint='Hide the dark game background and wrap the view in a solid sky-colored dome.' />

    <color-setting text='Background Color'
                   value='background-color'
                   apply-on-change='true'
                   bind-value='true'
                   hover-hint='Color of the sky dome. Actual displayed brightness is scaled by Background Brightness below.' />

    <increment-setting text='Background Brightness'
                       value='background-brightness'
                       apply-on-change='true'
                       bind-value='true'
                       min='0' max='2' increment='0.05'
                       hover-hint='Multiplies the sky color brightness (RGB).' />

    <increment-setting text='Background Alpha'
                       value='background-alpha'
                       apply-on-change='true'
                       bind-value='true'
                       min='0' max='1' increment='0.05'
                       hover-hint='1 = opaque dome (hides original background, whiteout-resistant). Below 1 = keeps the original background visible and blends a real translucent tint over it instead. Rebuilds on next Sky Background toggle.' />

    <!-- ───────── Floor ───────── -->
    <horizontal spacing='1' pad='0' pad-top='1'>
      <text text='[Floor]' color='#00CED1' />
    </horizontal>

    <toggle-setting text='Show Floor'
            value='show-floor'
            apply-on-change='true'
            bind-value='true'
            hover-hint='Show or hide the floor itself.' />

    <toggle-setting text='Mirror Reflection'
        value='mirror-reflection'
        apply-on-change='true'
        bind-value='true'
        hover-hint='When the game Mirror quality is ON, keep the reflective floor so it reflects the sky and notes (Floor Color is not used then). When Mirror is OFF, the floor is painted with Floor Color.' />

    <toggle-setting text='Floor Customize'
        value='paint-floor'
        apply-on-change='true'
        bind-value='true'
        hover-hint='Apply the Floor Color settings to the reflective floor (Mirror), independent of Background.' />

    <color-setting text='　Floor Color'
                   value='floor-color'
                   apply-on-change='true'
                   bind-value='true'
                   hover-hint='Color for the floor (translucent flat paint).' />

    <increment-setting text='　Floor Brightness'
                       value='floor-brightness'
                       apply-on-change='true'
                       bind-value='true'
                       min='0' max='2' increment='0.1'
                       hover-hint='Multiplies the floor color brightness. With Bloom ON a bright floor will glow/white out -- lower this (or Opacity) to stop the floor glowing.' />

    <increment-setting text='　Floor Opacity'
                       value='floor-alpha'
                       apply-on-change='true'
                       bind-value='true'
                       min='0' max='1' increment='0.05'
                       hover-hint='Opacity of the floor. Lower = more see-through AND dimmer, so it glows less with Bloom ON.' />
    </settings-container>
  </tab>
  <tab tags='skylight-tabs' tab-name='Objects' anchor-min-x='0' anchor-max-x='1' anchor-min-y='0' anchor-max-y='1' size-delta-y='-8' anchor-pos-y='-4'>
    <settings-container child-control-width='true' child-expand-width='true' spacing='0' pad='0'>
    <!-- ───────── Structures ───────── -->
    <horizontal spacing='1' pad='0' pad-top='1'>
      <text text='[Structures]' color='#DDA0DD' />
    </horizontal>

    <toggle-setting text='Show Structures'
            value='show-structures'
            apply-on-change='true'
            bind-value='true'
            hover-hint='Show or hide the matched structure objects.' />

        <toggle-setting text='Structures Customize'
            value='paint-structures'
            apply-on-change='true'
            bind-value='true'
            hover-hint='Apply structure color and opacity settings to the environment structures.' />

    <toggle-setting text='　Structure Colorize'
                    value='structure-colorize'
                    apply-on-change='true'
                    bind-value='true'
                    hover-hint='ON = tint structures with Structure Color. OFF = keep the original color/look and only change the opacity (transparency only).' />

    <color-setting text='　　Structure Color'
                   value='structure-color'
                   apply-on-change='true'
                   bind-value='true'
                   hover-hint='Color for the structures (translucent).' />

    <increment-setting text='　　Structure Brightness'
                       value='structure-brightness'
                       apply-on-change='true'
                       bind-value='true'
                       min='0' max='2' increment='0.1'
                       hover-hint='Multiplies the structure color brightness (RGB).' />

    <increment-setting text='　Structure Opacity'
                       value='structure-alpha'
                       apply-on-change='true'
                       bind-value='true'
                       min='0' max='1' increment='0.05'
                       hover-hint='Opacity of the structures. Lower = more see-through (original shows behind).' />

    <!-- ───────── Ring ───────── -->
    <horizontal spacing='1' pad='0' pad-top='1'>
      <text text='[Ring]' color='#9ACD32' />
    </horizontal>

    <toggle-setting text='Show Ring'
            value='show-ring'
            apply-on-change='true'
            bind-value='true'
            hover-hint='Show or hide matched ring objects.' />

    <toggle-setting text='Ring Customize'
        value='paint-ring'
        apply-on-change='true'
        bind-value='true'
        hover-hint='Apply ring color and opacity settings to ring objects.' />

    <toggle-setting text='　Ring Colorize'
                    value='ring-colorize'
                    apply-on-change='true'
                    bind-value='true'
                    hover-hint='ON = tint rings with Ring Color. OFF = keep original color, only change opacity.' />

    <color-setting text='　　Ring Color'
                   value='ring-color'
                   apply-on-change='true'
                   bind-value='true'
                   hover-hint='Color for rings (translucent).' />

    <increment-setting text='　　Ring Brightness'
                       value='ring-brightness'
                       apply-on-change='true'
                       bind-value='true'
                       min='0' max='2' increment='0.1'
                       hover-hint='Multiplies the ring color brightness (RGB).' />

    <increment-setting text='　Ring Opacity'
                       value='ring-alpha'
                       apply-on-change='true'
                       bind-value='true'
                       min='0' max='1' increment='0.05'
                       hover-hint='Opacity of the rings. Lower = more see-through.' />
    </settings-container>
  </tab>
  <tab tags='skylight-tabs' tab-name='Hide' anchor-min-x='0' anchor-max-x='1' anchor-min-y='0' anchor-max-y='1' size-delta-y='-8' anchor-pos-y='-4'>
    <settings-container child-control-width='true' child-expand-width='true' spacing='0' pad='0'>
    <!-- 全環境共通の Hide Objects / Exclude は画面に出さない（SkyLight.json の HideObjectHints / HideObjectExcludeHints で設定できる） -->

    <!-- ───────── Hide Objects per Environment ───────── -->
    <horizontal spacing='1' pad='0' pad-top='1'>
      <text text='[Hide Objects per Environment]' color='#FFD700' />
    </horizontal>

    <dropdown-list-setting text='Environment'
                           id='env-dropdown'
                           value='env-selected'
                           options='env-options'
                           apply-on-change='true'
                           bind-value='true'
                           on-change='select-env'
                           hover-hint='Environment to edit. The list grows as you play new environments.' />

    <horizontal spacing='1' pad='0'>
      <button text='Last Played' on-click='env-last-played'
              hover-hint='Select the environment you played last (and reload the list).' />
    </horizontal>

    <dropdown-list-setting text='　Object'
                           id='env-object-dropdown'
                           value='env-object-selected'
                           options='env-object-options'
                           apply-on-change='true'
                           bind-value='true'
                           on-change='select-env-object'
                           hover-hint='Objects found in this environment. [Hidden] = hidden here. [Main] = hidden by SkyLight settings (e.g. Ring OFF) last time you played. [Part] = partly hidden. No mark = visible. Main/Part update when you play this environment again. Group names (e.g. Car4) hide all parts under them.' />

    <horizontal spacing='1' pad='0'>
      <button text='Hide' on-click='env-hide-object'
              hover-hint='Hide the selected object in this environment (from the next song).' />
      <button text='Show' on-click='env-show-object'
              hover-hint='Stop hiding the selected object in this environment.' />
    </horizontal>

    <string-setting text='　Hide (this env)'
                    value='env-hide'
                    apply-on-change='true'
                    bind-value='true'
                    hover-hint='Names hidden in this environment (partial match on name or path, separate with ;). You can type your own, e.g. Car.' />

    <toggle-setting text='Dump Scene (log hide candidates)'
                    value='dump-scene'
                    apply-on-change='true'
                    bind-value='true'
                    hover-hint='Write scene diagnostics including the "Hide candidates" object list to the log at song start. Turn OFF when done.' />
    </settings-container>
  </tab>
</bg>
